# PostgreSQL Configuration
POSTGRES_USER=jobseeker
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=job_pipeline
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Pipeline Configuration
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=15
USER_AGENT="JobPipelineBot/1.0 (+https://github.com/)"

# Reddit OAuth (required for r/forhire / r/hiring extraction)
# Create a "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# GitHub Search API (optional) - raises rate limit 60/hr -> 5000/hr
GITHUB_TOKEN=
